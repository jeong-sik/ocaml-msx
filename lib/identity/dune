; Which core a client linked. The source digest covers lib/'s top-level
; implementation and its dune file. The exact Git commit is recorded only for
; a clean checkout. The full source tree dependency keeps the commit identity
; current when any tracked source changes.

(library
 (name msx_core_identity)
 (public_name ocaml-msx.core-identity)
 (modules msx_core_identity))

(rule
 (targets msx_core_identity.ml)
 (deps
  (:digest
   ../dune
   (glob_files ../*.ml)
   (glob_files ../*.mli))
  (source_tree ../..))
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:gen/gen_core_identity.exe} %{digest}))))
