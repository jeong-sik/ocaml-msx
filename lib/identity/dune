; Which core a client linked. The source digest covers lib/'s top-level
; implementation and its dune file. The exact Git commit is recorded only for
; the project's own clean checkout. Git metadata is outside source_tree:
; universe reruns this rule for commits with unchanged source bytes and keeps
; the result out of Dune's shared cache. Source dependencies remain explicit.

(library
 (name msx_core_identity)
 (public_name ocaml-msx.core-identity)
 (modules msx_core_identity))

(rule
 (targets msx_core_identity.ml)
 (deps
  (:digest
   ../dune
   (glob_files ../*.ml)
   (glob_files ../*.mli))
  (source_tree ../..)
  (universe))
 (action
  (chdir %{workspace_root}
   (with-stdout-to
    %{targets}
    (run %{exe:gen/gen_core_identity.exe} %{project_root} %{digest})))))
